# Skopiuj ten plik jako .env i wpisz klucze. Pliku .env NIE commitujemy.

# Klucze – wystarczy jeden, drugi jako zapas
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Kolejność modeli: pierwszy działający wygrywa (format LiteLLM: dostawca/model).
# Nazwy modeli sprawdź w dokumentacji dostawcy – zmieniają się.
LLM_MODELS=anthropic/claude-sonnet-4-5,openai/gpt-4o-mini,gemini/gemini-2.0-flash

# Polski model lokalnie przez Ollamę (opcjonalnie, dopisz do LLM_MODELS):
# ollama/SpeakLeash/bielik-11b-v2.3-instruct:Q4_K_M
# OLLAMA_API_BASE=http://localhost:11434

# Asystent (podpowiedzi AI): off = tylko szablony i reguły, local = Ollama, api = jeszcze niezaimplementowane
AI_MODE=local
# OLLAMA_API_BASE=http://localhost:11434
# Model do szkiców, przygotowania rozmowy i HR partnera (najpierw: ollama pull <model>)
AI_LOCAL_MODEL_TEXT=SpeakLeash/bielik-11b-v2.3-instruct:Q4_K_M
# Model do klasyfikacji notatek – może być mniejszy (domyślnie ten sam co wyżej)
# AI_LOCAL_MODEL_FAST=
AI_TIMEOUT_S=60
# Sugestie klasyfikacji poniżej tej pewności trafiają do ręcznego przypisania
AI_MIN_CONFIDENCE=0.6

# Ustaw 1, jeśli chcesz pracować bez kluczy (LLM zwraca atrapę odpowiedzi)
LLM_MOCK=0

DB_PATH=data/app.db

# Baza: puste = SQLite w DB_PATH. PostgreSQL (wymaga: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://user:haslo@localhost:5432/oceny
DATABASE_URL=
