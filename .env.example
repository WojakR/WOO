# Skopiuj ten plik jako .env i wpisz klucze. Pliku .env NIE commitujemy.

# Klucze – wystarczy jeden, drugi jako zapas
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Kolejność modeli: pierwszy działający wygrywa (format LiteLLM: dostawca/model).
# Nazwy modeli sprawdź w dokumentacji dostawcy – zmieniają się.
LLM_MODELS=anthropic/claude-sonnet-4-5,openai/gpt-4o-mini,gemini/gemini-2.0-flash

# Polski model lokalnie przez Ollamę (opcjonalnie, dopisz do LLM_MODELS):
# ollama/SpeakLeash/bielik-11b-v2.3-instruct:Q4_K_M
# OLLAMA_API_BASE=http://localhost:11434

# Asystent (podpowiedzi AI): off = tylko szablony i reguły, local = Ollama, api = model zewnętrzny przez LiteLLM
# (LLM_MODELS + klucz dostawcy; nazwiska, PESEL i e-maile są pseudonimizowane przed wysłaniem)
AI_MODE=local
# OLLAMA_API_BASE=http://localhost:11434
# Model do szkiców, przygotowania rozmowy i HR partnera (najpierw: ollama pull <model>)
AI_LOCAL_MODEL_TEXT=SpeakLeash/bielik-11b-v2.3-instruct:Q4_K_M
# Model do klasyfikacji notatek – może być mniejszy (domyślnie ten sam co wyżej)
# AI_LOCAL_MODEL_FAST=
AI_TIMEOUT_S=60
# Sugestie klasyfikacji poniżej tej pewności trafiają do ręcznego przypisania
AI_MIN_CONFIDENCE=0.6

# Ustaw 1, jeśli chcesz pracować bez kluczy (LLM zwraca atrapę odpowiedzi)
LLM_MOCK=0

# Logowanie: demo = przełącznik tożsamości w pasku (nagłówek X-User-Id), session = ekran logowania
AUTH_MODE=demo
# Klucz podpisu ciasteczka sesji – długi losowy ciąg, np.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Długość sesji w godzinach; SESSION_COOKIE_SECURE=1 gdy aplikacja działa za HTTPS
SESSION_HOURS=8
SESSION_COOKIE_SECURE=0
# Tylko pokaz: przy pustej tabeli kont tryb session zakłada konto dla każdego pracownika (login = id
# z pracownicy.json) i „kadry” z tym hasłem. Konta produkcyjne: python -m app.api.auth add <login> <id|kadry> [--admin]
AUTH_DEMO_PASSWORD=

DB_PATH=data/app.db

# Baza: puste = SQLite w DB_PATH. PostgreSQL (wymaga: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://user:haslo@localhost:5432/oceny
DATABASE_URL=

# Tryb aplikacji: demo = scenariusz demonstracyjny, „przewiń czas”, /api/demo/*;
# production = zegar systemowy (Europe/Warsaw), bez funkcji demo, pusta baza zostaje pusta
APP_MODE=demo

# Przypomnienia e-mailem: uruchamiaj raz dziennie (lub co godzinę w godzinach pracy)
#   python -m app.application.notify_job
# Puste SMTP_HOST = bez e-maili (tylko powiadomienia w aplikacji)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# Eksport arkuszy do e-Akt (akta osobowe, część B) po zapoznaniu się z oceną i po rozpatrzeniu sprzeciwu.
# off = wyłączony; katalog = PDF + metadane JSON do katalogu EAKT_DIR; http = adapter usługi e-Akt (niegotowy –
# wymaga specyfikacji interfejsu od dostawcy, zgłasza NotImplementedError)
EAKT_MODE=katalog
EAKT_DIR=data/eakt
# EAKT_URL=https://eakt.example.gov.pl/api
# EAKT_TOKEN=

# Rejestracja dokumentów oceny w EZD (arkusz po zapoznaniu, pismo o zmianie terminu).
# off = wyłączona; katalog = paczki importu (PDF + metadane.json) w EZD_DIR; http = adapter usługi EZD (niegotowy –
# wymaga specyfikacji interfejsu od dostawcy, zgłasza NotImplementedError z listą pytań)
EZD_MODE=katalog
EZD_DIR=data/ezd
# klasa JRWA dla ocen okresowych w urzędzie
EZD_JRWA=
# EZD_URL=https://ezd.example.gov.pl/api
# EZD_TOKEN=

# Adres działu kadr (powiadomienia: zmiana oceny po sprzeciwie, wniosek o kolejny stopień)
HR_EMAIL=
